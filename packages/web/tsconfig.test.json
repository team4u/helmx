{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/web-test.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "paths": {
      "@helmx/protocol": [
        "../protocol/src/index.ts"
      ],
      "@helmx/protocol/browser": [
        "../protocol/src/browser.ts"
      ],
      "@helmx/kernel": [
        "../kernel/src/index.ts"
      ],
      "@helmx/kernel/testing": [
        "../kernel/src/testing.ts"
      ],
      "@helmx/plugins": [
        "../plugins/src/index.ts"
      ],
      "@helmx/plugins/*": [
        "../plugins/src/*"
      ]
    }
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
