{
  "name": "@helmx/cli",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "helmx": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/generate-sdk-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@helmx/env-io": "workspace:*",
    "@helmx/protocol": "workspace:*"
  },
  "devDependencies": {
    "@helmx/plugin-build": "workspace:*",
    "@helmx/test-kit": "workspace:*",
    "tar": "7.5.23"
  }
}
