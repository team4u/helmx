{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/plugins-client.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/*/client/**/*.ts",
    "src/*/client/**/*.tsx"
  ]
}
