{
  "name": "helmx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck:only": "node scripts/typecheck.mjs",
    "typecheck": "node scripts/build.mjs --for-typecheck && pnpm run typecheck:only",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/build.mjs --skip-payload && node scripts/test-suites.mjs all",
    "test:all": "node scripts/build.mjs --skip-payload && node scripts/test-suites.mjs all",
    "test:unit": "node scripts/build.mjs --unit-deps && node scripts/test-suites.mjs unit",
    "test:integration": "node scripts/build.mjs --skip-payload && node scripts/test-suites.mjs integration",
    "test:unit:run": "node scripts/test-suites.mjs unit",
    "test:integration:run": "node scripts/test-suites.mjs integration",
    "test:all:run": "node scripts/test-suites.mjs all",
    "test:force-exit": "node scripts/run-tests.mjs --test-force-exit \"packages/*/test/*.test.ts\" \"packages/*/test/*.test.tsx\"",
    "check:changed": "node scripts/check-changed.mjs",
    "release": "node scripts/release.mjs",
    "check:hygiene": "node scripts/check-test-hygiene.mjs",
    "lint": "oxlint",
    "dev": "pnpm --filter @helmx/protocol run build && pnpm --parallel --stream --filter @helmx/hub --filter @helmx/web run dev",
    "dev:kernel": "pnpm --filter @helmx/protocol run build && node scripts/run-hub.mjs",
    "dev:web": "pnpm --filter @helmx/web dev",
    "helmx": "tsx packages/cli/src/index.ts",
    "helmx-hub": "node scripts/run-hub.mjs",
    "helmx-node": "tsx packages/node/src/cli.ts",
    "link:bins": "node scripts/link-bins.mjs",
    "unlink:bins": "node scripts/link-bins.mjs --remove"
  },
  "devDependencies": {
    "@helmx/cli": "workspace:*",
    "@helmx/node": "workspace:*",
    "@types/node": "^24.0.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
